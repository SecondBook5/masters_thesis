  eprinttype   = {arXiv},
  eprintclass  = {q-bio.QM},
  abstract     = {Single-cell RNA-sequencing captures a temporal slice, or a
                  snapshot, of a cell differentiation process. A major
                  bioinformatical challenge is the inference of differentiation
                  trajectories from a single snapshot, and methods that account
                  for outlier cells that are unrelated to the differentiation
